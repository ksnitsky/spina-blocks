<div class="mt-6">
  <label class="block text-sm leading-5 font-medium text-gray-700"><%= f.object.title %></label>
  <% if f.object.hint.present? %>
    <div class="text-gray-400 text-sm"><%= f.object.hint %></div>
  <% end %>
  <div class="mt-1">
    <% if f.object.custom_block_name.present? %>
      <% custom_block = f.object.custom_block_record %>
      <% if custom_block %>
        <%= link_to custom_block.name,
              spina.edit_blocks_admin_block_path(custom_block),
              class: "inline-flex items-center text-sm font-medium text-spina-primary hover:underline" %>
      <% else %>
        <span class="text-sm text-red-500"><%= t('spina.blocks.custom_block_not_found') %></span>
      <% end %>
    <% else %>
      <% blocks = f.object.available_blocks %>
      <%= f.select :block_id,
            blocks.map { |b| [b.name, b.id] },
            {include_blank: t('spina.blocks.select_block')},
            class: "form-select text-sm w-full shadow-xs" %>
    <% end %>
  </div>
</div>
